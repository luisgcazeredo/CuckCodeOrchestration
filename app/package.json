{
  "name": "orkester",
  "productName": "Orkester",
  "version": "0.30.0",
  "private": true,
  "description": "Quadro infinito para orquestrar agentes de código",
  "author": "Luís Azeredo",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite dev",
    "build": "electron-vite build",
    "start": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "marca": "node scripts/gerar-marca.mjs ../identidade/orkester-original.png",
    "provas": "node --test \"src/**/*.prova.mts\"",
    "autoteste": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite build && electron . --autoteste",
    "icone": "node scripts/gerar-icone.mjs",
    "empacotar": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite build && electron-builder --win --x64",
    "instalar": "npm run empacotar && node scripts/instalar.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0",
    "highlight.js": "11.12.0",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  },
  "build": {
    "appId": "br.luisao.orkester",
    "productName": "Orkester",
    "executableName": "Orkester",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "!out/autoteste*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "out/main/cli.js"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Orkester",
      "uninstallDisplayName": "Orkester",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Orkester-Instalador-${version}.${ext}"
    }
  }
}
